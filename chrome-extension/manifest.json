{
  "manifest_version": 3,
  "name": "Local Blog KB 剪藏",
  "version": "1.0",
  "description": "将网页内容剪藏到 Local Blog KB",
  "permissions": ["contextMenus", "activeTab", "storage"],
  "host_permissions": ["http://localhost:3456/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "剪藏到 Local Blog KB",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}

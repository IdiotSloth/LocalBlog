{
  "name": "local-blog-kb",
  "version": "0.3.0",
  "description": "本地博客与知识库存储系统 - 离线可用的个人桌面应用",
  "main": "./out/main/index.js",
  "author": "Idiot",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/run.js electron-vite dev",
    "build": "electron-vite build && node scripts/post-build.js",
    "server": "node scripts/run.js tsx src/server/index.ts",
    "preview": "electron-vite preview",
    "start": "node scripts/run.js electron .",
    "pack": "node scripts/run.js node scripts/pack.js",
    "package": "node scripts/run.js electron-forge package",
    "make": "node scripts/run.js electron-forge make",
    "lint": "biome check src/ tests/",
    "lint:arch": "node scripts/lint-arch.js",
    "lint:all": "biome check src/ tests/ && node scripts/lint-arch.js && npx tsc -p tsconfig.node.json --noEmit && npx tsc -p tsconfig.web.json --noEmit",
    "format": "biome format src/ tests/ --write",
    "check": "biome check src/ tests/ --write",
    "gc": "node scripts/gc.js",
    "gc:audit": "node scripts/gc.js --audit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "review": "node scripts/lint-arch.js && biome check src/ tests/ && npx tsc -p tsconfig.node.json --noEmit && npx tsc -p tsconfig.web.json --noEmit && npm run build",
    "docs:ipc": "npx tsx scripts/generate-ipc-doc.ts",
    "ci": "node scripts/lint-arch.js && biome check src/ tests/ && npx tsc -p tsconfig.node.json --noEmit && npx tsc -p tsconfig.web.json --noEmit && npm run build && vitest run"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "@tiptap/extension-code-block-lowlight": "^3.22.5",
    "@tiptap/extension-image": "^3.22.5",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/extension-table": "^3.22.5",
    "@tiptap/extension-table-cell": "^3.22.5",
    "@tiptap/extension-table-header": "^3.22.5",
    "@tiptap/extension-table-row": "^3.22.5",
    "@tiptap/extension-task-item": "^3.22.5",
    "@tiptap/extension-task-list": "^3.22.5",
    "@tiptap/extension-underline": "^3.22.5",
    "@tiptap/pm": "^3.22.0",
    "@tiptap/react": "^3.22.0",
    "@tiptap/starter-kit": "^3.22.0",
    "@types/multer": "^2.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.6.1",
    "dompurify": "^3.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "linkedom": "^0.18.12",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.8.0",
    "markdown-it": "^14.1.0",
    "multer": "^2.1.1",
    "mysql2": "^3.22.3",
    "pdfjs-dist": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.30.0",
    "sql.js": "^1.14.1",
    "turndown": "^7.2.0",
    "zod": "^4.4.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@electron-forge/cli": "^7.11.0",
    "@electron-forge/maker-deb": "^7.11.0",
    "@electron-forge/maker-dmg": "^7.11.0",
    "@electron-forge/maker-rpm": "^7.11.0",
    "@electron-forge/maker-squirrel": "^7.11.0",
    "@electron-forge/maker-zip": "^7.11.0",
    "@electron-forge/plugin-vite": "^7.11.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/markdown-it": "^14.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^41.2.0",
    "electron-vite": "^5.0.0",
    "lefthook": "^1.10.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
